/target
.stignore
.syncthing.*
*.sync-conflict*

# gettext msgmerge backups — regenerated on every catalog update
*.po~

# Headless-control bins (dm-ctl, bootbench) staged in by the
# darkmatter-automated-testing harness to build against this crate. They live in
# that repo, not here — see its README. A plain `cargo build` ignores them
# until the harness stages them.
/src/bin/

# dpkg-buildpackage artifacts
/debian/.debhelper/
/debian/debhelper-build-stamp
/debian/files
/debian/whitenoise-linux.substvars
/debian/whitenoise-linux/
/assets/whitenoise-linux-*.png
